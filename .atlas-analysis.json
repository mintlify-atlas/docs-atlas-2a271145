  "keyFeatures": [
    "Async-first API using Python asyncio, anyio, or trio",
    "Fluent request builder pattern with IDE autocomplete",
    "Strongly-typed model classes auto-generated from Graph API metadata",
    "Built-in authentication with Azure Identity (delegated and application permissions)",
    "Automatic pagination support via odata_next_link",
    "Batch request support",
    "Configurable HTTP middleware and proxy support",
    "Support for Python 3.9 through 3.13"
  ],
  "publicApiSurface": [
    "GraphServiceClient(credentials, scopes, request_adapter)",
    "GraphRequestAdapter(auth_provider, client)",
